# ===== winkox — MySQL configuration for Hostinger =====
# Fill these values on Hostinger and keep the super admin password here only.
# If these are not set, the app falls back to browser LocalDB mode.
NEXT_PUBLIC_APP_NAME=winkox

# Hostinger Node.js app and MySQL database are on the same server.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=u113090363_xgames
MYSQL_USER=u113090363_winko
MYSQL_PASSWORD=UmarZeeshan123
MYSQL_SSL=false

# Super admin login - this password stays in env and should only be used by the root admin.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_ID=WX-ADM-0001
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PHONE=03000000000
SUPER_ADMIN_PASSWORD=admin
SUPER_ADMIN_DEPOSIT_LIMIT=0

# Optional app defaults
NEXTAUTH_SECRET=09875redcvbjkjy3456789iuhgc
